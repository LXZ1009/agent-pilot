AGENT_PILOT_MODEL=openai:gpt-5.4
OPENAI_API_KEY=replace-me
# Optional OpenAI-compatible endpoint, for example DashScope compatible mode.
# OPENAI_BASE_URL=https://your-openai-compatible-endpoint/v1
# AGENT_PILOT_TEMPERATURE=0.2
# AGENT_PILOT_OPENAI_EXTRA_BODY_JSON={"enable_thinking":false}
# AGENT_PILOT_PARALLEL_TOOL_CALLS=false
# GOOGLE_API_KEY=replace-me
# ANTHROPIC_API_KEY=replace-me
# Optional remote Agent Protocol server for official DeepAgents AsyncSubAgent mode.
# Leave empty when running all graphs in local langgraph dev.
# DEEPAGENTS_ASYNC_SUBAGENT_URL=https://your-langgraph-server
